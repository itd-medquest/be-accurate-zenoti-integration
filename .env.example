PORT=4000
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# MySQL 8.4 LTS (InnoDB). Encode karakter khusus password pada URL.
DATABASE_URL=mysql://intgrte:replace-with-mysql-password@localhost:3306/intgrte
# Aktifkan untuk koneksi TLS server; sertifikat tetap diverifikasi.
DATABASE_SSL=false
# Untuk Docker Compose lokal. Samakan MYSQL_PASSWORD dengan URL.
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-strong-root-password
# Default demo lama. Mode aktual dipilih secara eksplisit melalui Settings Accurate.
INTEGRATION_MODE=simulation
RUN_WORKER=true
# Kebijakan paket disetujui Accounting: layanan setelah diskon, pajak proporsional, total harus identik.
IMPORT_PACKAGE_TAX_POLICY=proportional
# Bootstrap deployment: npm run db:seed:admin (tanpa akun/invoice demo).
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
# Kunci hex 64 karakter untuk enkripsi kredensial AES-256-GCM.
ENCRYPTION_KEY=
# Opsional: transfer akun dari PostgreSQL/PGlite. Simpan URL/kunci secara privat.
SOURCE_DATABASE_URL=
USER_TRANSFER_KEY=
# Setup perusahaan kosong tanpa invoice atau kredensial integrasi.
SETUP_COMPANY_ID=branch-jakarta
SETUP_COMPANY_NAME=PT. MMI
SETUP_CENTER_ID=center-jakarta
ZENOTI_API_URL=
ZENOTI_API_KEY=
# API Token dan Signature Secret Accurate diisi lewat Settings, lalu disimpan terenkripsi.
# Lupa password: API key hanya di backend. Sender uji dibatasi oleh Resend.
RESEND_API_KEY=
RESEND_FROM="intgrte <onboarding@resend.dev>"
